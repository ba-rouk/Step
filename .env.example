# Browser-safe configuration. Publishable keys can be used by the browser.
VITE_SUPABASE_URL=https://tyuousqmpexrwmnmvxtd.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_YOUR_PROJECT_PUBLISHABLE_KEY

# Server-side customer session encryption secret.
# Generate a strong random value (at least 32 bytes) and keep it only in Render Environment.
SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_64_HEX_CHARACTERS

# Optional server aliases; VITE_ values above are read when these are omitted.
SUPABASE_URL=https://tyuousqmpexrwmnmvxtd.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_YOUR_PROJECT_PUBLISHABLE_KEY
