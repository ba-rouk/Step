# Browser-safe Supabase configuration. Publishable keys only.
VITE_SUPABASE_URL=https://tyuousqmpexrwmnmvxtd.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_YOUR_PROJECT_PUBLISHABLE_KEY

# Public application URL (also set as an Edge Function secret for tracking email links).
APP_URL=https://steptown.onrender.com

# Server-side Supabase settings. Never expose the service-role key to Vite/browser code.
SUPABASE_URL=https://tyuousqmpexrwmnmvxtd.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_YOUR_PROJECT_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY

# Generate with: openssl rand -hex 48
# Used for the httpOnly customer session, HMAC login-code hashes and encrypted email jobs.
SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_64_HEX_CHARACTERS

# Cart access policy: false means guests can view and edit localStorage cart contents.
REQUIRE_LOGIN_FOR_CART_LIST=false

# Transactional email over HTTPS API (SMTP/Nodemailer SMTP transport is not used).
# Supported: resend (default), brevo, postmark, mailgun, sendgrid.
EMAIL_PROVIDER=resend
EMAIL_API_KEY=REPLACE_WITH_PROVIDER_API_KEY
EMAIL_FROM=orders@steptown.rw
EMAIL_FROM_NAME=Step Town

# Optional safe test mode: all queued emails are redirected to this test inbox.
EMAIL_SANDBOX=false
EMAIL_SANDBOX_TO=your-test-inbox@example.com

# Required only for Mailgun. Optional Postmark stream override.
MAILGUN_DOMAIN=
POSTMARK_MESSAGE_STREAM=outbound
