# Browser-safe configuration. Publishable keys can be used by the browser.
VITE_SUPABASE_URL=https://tyuousqmpexrwmnmvxtd.supabase.co
SITE_URL=https://vitanova-1hfh.onrender.com
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_YOUR_PROJECT_PUBLISHABLE_KEY

# Server-side customer session encryption secret.
# Generate a strong random value (at least 32 bytes) and keep it only in Render Environment.
SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_64_HEX_CHARACTERS

# Optional server aliases; VITE_ values above are read when these are omitted.
SUPABASE_URL=https://tyuousqmpexrwmnmvxtd.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_YOUR_PROJECT_PUBLISHABLE_KEY

# Supabase server-side secret: required by email-code Edge Functions and never exposed to Vite.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_VITANOVA_SERVICE_ROLE_KEY

# Email delivery over HTTPS only. Render blocks outbound SMTP; do not configure SMTP.
EMAIL_PROVIDER=resend
EMAIL_API_KEY=re_REPLACE_WITH_PROVIDER_API_KEY
EMAIL_FROM=Vitanova <orders@your-verified-domain.example>
EMAIL_FROM_NAME=Vitanova

# Protect internal outbox processing and one-time code hashing.
EMAIL_OUTBOX_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
LOGIN_CODE_PEPPER=REPLACE_WITH_ANOTHER_RANDOM_SECRET_AT_LEAST_32_BYTES

# Optional provider-specific configuration:
# MAILGUN_DOMAIN=mg.your-verified-domain.example
